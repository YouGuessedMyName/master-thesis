     "text": [
      "{ [x, y] -> [(1), (1)] : x >= 0 and y >= 0; [x, y] -> [(0), (0)] : x < 0 or (x >= 0 and y < 0) }\n"
     ]
    }
   ],
   "source": [
    "import islpy as isl\n",
    "\n",
    "ctx = isl.DEFAULT_CONTEXT\n",
    "\n",
    "f = isl.PwMultiAff.read_from_str(\n",
    "    ctx,\n",
    "    \"\"\"\n",
    "    {\n",
    "        [x,y] -> [1,1] : x >= 0 and y >= 0;\n",
    "        [x,y] -> [0,0]\n",
    "    }\n",
    "    \"\"\"\n",
    ")\n",
    "\n",
    "print(f)"
   ]
  },
